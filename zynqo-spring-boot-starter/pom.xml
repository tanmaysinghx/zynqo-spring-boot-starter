<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.tanmaysinghx</groupId>
    <artifactId>zynqo-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>zynqo-spring-boot-starter</artifactId>

  <name>Zynqo Spring Boot Starter</name>
  <description>Starter for declarative, Redis-backed API idempotency in Spring Boot MVC applications.</description>
  <url>https://github.com/tanmaysinghx/zynqo-spring-boot-starter</url>

  <properties>
    <!-- Dependency aggregation only: there is no code to cover. -->
    <jacoco.skip.check>true</jacoco.skip.check>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.tanmaysinghx</groupId>
      <artifactId>zynqo-spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.tanmaysinghx</groupId>
      <artifactId>zynqo-storage-redis</artifactId>
    </dependency>
    <dependency>
      <!-- Auto-configures the application's RedisConnectionFactory from spring.data.redis.* (Lettuce). -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>io.github.tanmaysinghx.zynqo.starter</Automatic-Module-Name>
            </manifestEntries>
          </archive>
          <!-- Central requires a main artifact; an empty starter jar is the Spring Boot convention. -->
          <skipIfEmpty>false</skipIfEmpty>
        </configuration>
        <executions>
          <!-- Maven Central requires sources and javadoc jars; this module has no sources. -->
          <execution>
            <id>empty-sources-jar</id>
            <goals>
              <goal>jar</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <classifier>sources</classifier>
              <classesDirectory>${project.basedir}/src/main/doc</classesDirectory>
            </configuration>
          </execution>
          <execution>
            <id>empty-javadoc-jar</id>
            <goals>
              <goal>jar</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <classifier>javadoc</classifier>
              <classesDirectory>${project.basedir}/src/main/doc</classesDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
